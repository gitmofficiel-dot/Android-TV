diff --git a/ssvdevice/ssv_proc_compat.h b/ssvdevice/ssv_proc_compat.h
new file mode 100644
index 0000000..b2f7187
--- /dev/null
+++ b/ssvdevice/ssv_proc_compat.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SSV_PROC_COMPAT_H
+#define SSV_PROC_COMPAT_H
+#include <linux/version.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/proc_fs.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 6, 0)
+#define SSV_PROC_OPS struct file_operations
+#define SSV_PROC_OWNER .owner = THIS_MODULE,
+#define SSV_PROC_OPEN open
+#define SSV_PROC_READ read
+#define SSV_PROC_WRITE write
+#define SSV_PROC_LSEEK llseek
+#define SSV_PROC_RELEASE release
+#else
+#define SSV_PROC_OPS struct proc_ops
+#define SSV_PROC_OWNER
+#define SSV_PROC_OPEN proc_open
+#define SSV_PROC_READ proc_read
+#define SSV_PROC_WRITE proc_write
+#define SSV_PROC_LSEEK proc_lseek
+#define SSV_PROC_RELEASE proc_release
+#endif
+
+static inline void *ssv_pde_data(const struct inode *inode)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 17, 0)
+    return PDE_DATA(inode);
+#else
+    return pde_data(inode);
+#endif
+}
+#endif
