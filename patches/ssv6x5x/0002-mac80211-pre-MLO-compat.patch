diff --git a/smac/ssv_mac80211_compat.h b/smac/ssv_mac80211_compat.h
new file mode 100644
index 0000000..d92a871
--- /dev/null
+++ b/smac/ssv_mac80211_compat.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SSV_MAC80211_COMPAT_H
+#define SSV_MAC80211_COMPAT_H
+#include <linux/version.h>
+#include <linux/types.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 19, 0)
+#define SSV_STA_HT_CAP(sta) ((sta)->deflink.ht_cap)
+#else
+#define SSV_STA_HT_CAP(sta) ((sta)->ht_cap)
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 0, 0)
+#define SSV_VIF_ASSOC(vif) ((vif)->cfg.assoc)
+#define SSV_VIF_AID(vif) ((vif)->cfg.aid)
+#define SSV_CONF_TX_LINK_ARG unsigned int link_id,
+typedef u64 ssv_bss_changed_t;
+#else
+#define SSV_VIF_ASSOC(vif) ((vif)->bss_conf.assoc)
+#define SSV_VIF_AID(vif) ((vif)->bss_conf.aid)
+#define SSV_CONF_TX_LINK_ARG
+typedef u32 ssv_bss_changed_t;
+#endif
+#endif
